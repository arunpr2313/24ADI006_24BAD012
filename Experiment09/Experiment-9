        "# Test the model with new text inputs  | Arun PR 24BAD012\n",
        "def predict_sentiment(texts):\n",
        "    bert_model.eval()\n",
        "    inputs = tokenizer(texts, truncation=True, padding=True, max_length=MAX_LEN, return_tensors=\"pt\").to(bert_model.device)\n",
        "    with torch.no_grad():\n",
        "        logits = bert_model(**inputs).logits\n",
        "    probs = torch.softmax(logits, dim=-1).cpu().numpy()\n",
        "    preds = probs.argmax(axis=1)\n",
        "    return [(id2label[p], float(probs[i, p])) for i, p in enumerate(preds)]\n",
        "\n",
        "new_texts = [\n",
        "    \"This movie was absolutely fantastic! Great acting and a brilliant story.\",\n",
        "    \"A complete waste of time. The plot was boring and the acting was terrible.\",\n",
        "    \"I loved the cinematography, but the ending was disappointing.\",\n",
        "    \"One of the best films I have seen this year, highly recommended.\",\n",
        "    \"I could not finish it; the dialogue was awful and the pacing was painfully slow.\",\n",
        "]\n",
        "print(\"New text predictions — Arun PR 24BAD012\\n\")\n",
        "for text, (label, conf) in zip(new_texts, predict_sentiment(new_texts)):\n",
        "    print(f\"Text      : {text}\\nPredicted : {label} (confidence {conf:.3f})\\n\")"
      ]
    },
